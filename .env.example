# .env — variables d'environnement locales du projet "gestion groupe scolaire"
# Reprises telles que déjà définies dans db/run.sh et db/README.md.
# Ce fichier est ignoré par git (voir .gitignore). Modèle : .env.example

# ---------------------------------------------------------------------------
# Harnais de tests SQL (db/run.sh)
# ---------------------------------------------------------------------------

# Image du conteneur MySQL jetable utilisé par défaut
MYSQL_IMAGE=mysql:8.4

# Nom de la base recréée à chaque exécution des tests
DB_NAME=mlamine_test

# ---------------------------------------------------------------------------
# Cible MySQL existante (optionnel)
# Si DB_HOST est renseigné, db/run.sh l'utilise au lieu de lancer un conteneur.
# Laisser DB_HOST vide/commenté pour rester sur le mode Docker.
# ---------------------------------------------------------------------------

#DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------------------
# Constantes du schéma (Global Constraints du plan) — pour l'outillage applicatif
# ---------------------------------------------------------------------------

# Base de données de production/déploiement (cf. mlamine.sql)
APP_DB_NAME=mlamine
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Devise : FCFA, sans sous-unité -> montants en DECIMAL(12,0)
APP_CURRENCY=XAF

# Année scolaire par défaut (période académique octobre -> août)
APP_ANNEE_SCOLAIRE=2025-2026
