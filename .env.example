# .env — variables d'environnement locales du projet "gestion groupe scolaire"
# Reprises telles que déjà définies dans db/run.sh et db/README.md.
# Ce fichier est ignoré par git (voir .gitignore). Modèle : .env.example

# ---------------------------------------------------------------------------
# Harnais de tests SQL (db/run.sh)
# ---------------------------------------------------------------------------

# Image du conteneur MySQL jetable utilisé par défaut
MYSQL_IMAGE=mysql:8.4

# Nom de la base recréée à chaque exécution des tests
DB_NAME=mlamine_test

# ---------------------------------------------------------------------------
# Cible MySQL existante (optionnel)
# Si DB_HOST est renseigné, db/run.sh l'utilise au lieu de lancer un conteneur.
# Laisser DB_HOST vide/commenté pour rester sur le mode Docker.
# ---------------------------------------------------------------------------

#DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=

# ---------------------------------------------------------------------------
# Constantes du schéma (Global Constraints du plan) — pour l'outillage applicatif
# ---------------------------------------------------------------------------

# Base de données de production/déploiement (cf. mlamine.sql)
APP_DB_NAME=mlamine
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Devise : FCFA, sans sous-unité -> montants en DECIMAL(12,0)
APP_CURRENCY=XAF

# Année scolaire par défaut (période académique octobre -> août)
APP_ANNEE_SCOLAIRE=2025-2026

# ---------------------------------------------------------------------------
# Déploiement Docker Compose (infra/docker-compose.yml)
# ---------------------------------------------------------------------------

# Domaine servi par Caddy. `localhost` -> certificat interne (curl -k).
# Un domaine public -> certificat Let's Encrypt automatique.
SITE_ADDRESS=localhost

# Clé secrète Django — REMPLACER en production (>= 50 caractères).
DJANGO_SECRET_KEY=django-insecure-change-me-0000000000000000000000000000000000000000

# Hôtes autorisés (séparés par des virgules). Garder `localhost` sinon le
# healthcheck du conteneur `web` reçoit un HTTP 400.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Mots de passe MySQL 8.4 conteneurisé (service `db`). Le nom de base et
# l'utilisateur (`mlamine`) sont figés dans infra/docker-compose.yml, pas ici,
# pour ne pas entrer en conflit avec DB_NAME=mlamine_test du harnais SQL.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# Origines autorisées pour l'API (CORS) et, en admin sur un vrai domaine,
# origines de confiance CSRF (cf. infra/README.md).
CORS_ALLOWED_ORIGINS=https://localhost
